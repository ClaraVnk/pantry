# One-shot sweep of dead sessions and machine tokens (rootless).
#
# Install to:  ~/.config/containers/systemd/chaudron-purge-credentials.container
# Paired with: chaudron-purge-credentials.timer
# Script:      backend/scripts/purge_expired_credentials.py
# Inspect:     journalctl --user -u chaudron-purge-credentials.service
#
# ---------------------------------------------------------------------------
# WHAT THIS EXISTS FOR
# ---------------------------------------------------------------------------
# `user_session` is read on every authenticated request and nothing has ever
# removed a row from it. A browser that signs in and out ten times a day leaves
# ten dead rows behind. The index lookup does not care much; every backup, every
# restore drill and every VACUUM does, for data that authenticates nobody.
# `machine_token` grows the same way, more slowly.
#
# ---------------------------------------------------------------------------
# WHY IT USES THE OWNER DSN, LIKE THE MIGRATION UNIT AND UNLIKE THE API
# ---------------------------------------------------------------------------
# `machine_token` carries row-level security keyed on a transaction-local tenant
# (migration 0011). A sweep is by definition not scoped to one household, so the
# application role would have to post a tenant it does not have, and would delete
# nothing at all — silently, with an exit code of 0. This unit therefore takes
# `chaudron-database-url-owner`, the same secret chaudron-migrate.container takes
# and the only other unit that does.
#
# That is a privilege, so the work it does is deliberately narrow: two DELETE
# statements over rows that are already unusable, in one transaction, with a
# retention window. It creates nothing and alters nothing.
#
# ---------------------------------------------------------------------------
# RETENTION
# ---------------------------------------------------------------------------
# `--retention-days 30` by default, and not zero. These rows are the only record
# of when a session ended and whose it was, which is the first thing an incident
# review reads. Thirty days matches CHAUDRON_SESSION_ABSOLUTE_TTL_HOURS, so the
# record never has a shorter life than the credential it describes.
#
# Run it once by hand with `--dry-run` before enabling the timer:
#   podman exec chaudron python scripts/purge_expired_credentials.py --dry-run
# (or start this unit after editing Exec= to add the flag). A first run that
# reports a number you did not expect is worth reading before it is a delete.

[Unit]
Description=Chaudron — sweep expired and revoked credentials
Documentation=https://github.com/ClaraVnk/chaudron
After=chaudron-db.service
Requires=chaudron-db.service

[Container]
ContainerName=chaudron-purge-credentials
Image=ghcr.io/claravnk/chaudron:latest
Network=chaudron-net

Exec=python scripts/purge_expired_credentials.py --retention-days 30

EnvironmentFile=%h/chaudron/chaudron.env

# The owner's DSN. See the note above for why this unit needs it and why the
# API's role would silently do nothing.
Secret=chaudron-database-url-owner,type=env,target=CHAUDRON_DATABASE_URL

NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp:rw,size=32M,mode=1777

LogDriver=journald

# Two DELETEs over indexed predicates. If this needs more than a few seconds of
# CPU the tables have grown far past what this timer was meant to prevent, which
# is a thing to look at rather than a limit to raise.
PodmanArgs=--memory=256m --pids-limit=64

[Service]
Type=oneshot
RemainAfterExit=no
# A failed sweep is not an emergency: the next run does the same work. Retrying
# against a database in an unknown state is how a cleanup job becomes an outage.
Restart=no
TimeoutStartSec=300

MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=64
IOSchedulingClass=idle

# Deliberately no [Install]: the timer pulls this in.
