# Quadlet unit for the Chaudron PostgreSQL 16 database (rootless).
#
# Install to:   ~/.config/containers/systemd/chaudron-db.container
# Reload with:  systemctl --user daemon-reload
# Start with:   systemctl --user start chaudron-db.service
#
# Generated unit name is derived from the filename: chaudron-db.service.

[Unit]
Description=Chaudron — PostgreSQL 16
Documentation=https://github.com/ClaraVnk/chaudron
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=chaudron-db
# Fully-qualified image name: rootless Podman must not rely on short-name
# resolution, which is ambiguous and prompts interactively.
Image=docker.io/library/postgres:16
# `AutoUpdate=registry` is deliberately absent, unlike chaudron.container.
#
# The API is stateless and rolls back on its own when a new image fails its
# health check; the database does neither. Leaving auto-update on here meant the
# most critical component in the system restarting itself, at a time nobody
# chose, whenever upstream moved the `16` tag — no maintenance window, no
# verified backup taken first, and a minor-version bump of PostgreSQL applied
# unattended.
#
# Updating the database is a deliberate act, like a migration:
#
#   podman exec chaudron-db pg_dump -U chaudron -d chaudron --format=custom > db.dump
#   podman pull docker.io/library/postgres:16
#   systemctl --user restart chaudron-db.service
#
# Pinning to a digest instead of `16` would be stricter still, at the cost of a
# frozen image that stops receiving upstream security fixes until somebody
# remembers to bump it. The pull above is the point where that trade is made.

# Shared user-defined network so the API resolves the database by container
# name. Create it once: podman network create chaudron-net
Network=chaudron-net

# The database is never published to the host: only containers on chaudron-net
# reach it. Uncomment for local psql access, bound to loopback only.
# PublishPort=127.0.0.1:5432:5432

# SELinux: `:Z` relabels the bind mount with a container-private label
# (system_u:object_r:container_file_t:s0:cN,cM). Without it, the container is
# denied access under Enforcing. Use `:Z` — not `:z` — because no other
# container shares this directory.
Volume=%h/chaudron/data/postgres:/var/lib/postgresql/data:Z

Environment=POSTGRES_DB=chaudron
Environment=POSTGRES_USER=chaudron
# Keep the cluster in a subdirectory so lost+found and friends never confuse initdb.
Environment=PGDATA=/var/lib/postgresql/data/pgdata

# Password comes from a Podman secret, never from this file.
#   printf '%s' "$PW" | podman secret create chaudron-db-password -
Secret=chaudron-db-password,type=env,target=POSTGRES_PASSWORD

HealthCmd=pg_isready -U chaudron -d chaudron
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

NoNewPrivileges=true
DropCapability=ALL
AddCapability=CHOWN,DAC_OVERRIDE,FOWNER,SETGID,SETUID

LogDriver=journald

# Resource bounds. PostgreSQL is the component that must NOT be the one starved
# when something else on this host misbehaves, so its floor
# (`--memory-reservation`) is set as deliberately as its ceiling: under memory
# pressure the kernel reclaims from the containers that are above their
# reservation first.
#
# shared_buffers defaults to 128 MB and work_mem to 4 MB per sort; 768 MiB
# leaves room for a handful of concurrent queries plus the page cache the
# planner assumes. Raise this AND shared_buffers together, never one alone.
PodmanArgs=--memory=768m --memory-reservation=512m --pids-limit=512

[Service]
Restart=always
RestartSec=5
# First boot runs initdb; give it room before systemd calls it a failure.
TimeoutStartSec=300

# systemd-level ceilings on the unit cgroup. Deliberately above the container
# bound so that the kernel's OOM killer, if it ever runs here, kills the
# postgres backend the container limit already flagged rather than conmon.
MemoryHigh=640M
MemoryMax=896M
CPUQuota=150%
TasksMax=768

[Install]
WantedBy=default.target
