# Chaudron — weekly sweep of dead sessions and machine tokens.
#
# Install to:  ~chaudron/.config/systemd/user/chaudron-purge-credentials.timer
# Then:        systemctl --user daemon-reload
#              systemctl --user enable --now chaudron-purge-credentials.timer
# Verify:      systemctl --user list-timers chaudron-purge-credentials.timer
#
# Weekly, not daily, and not hourly. What this prevents is unbounded growth over
# years, and a household produces a handful of dead sessions a week — so the
# cadence that matters is "eventually and reliably", not "promptly". A frequent
# sweep would also make the thirty-day retention window look shorter than it is
# in the journal, which is the sort of thing that gets shortened by mistake.

[Unit]
Description=Chaudron — weekly credential sweep
Documentation=https://github.com/ClaraVnk/chaudron

[Timer]
Unit=chaudron-purge-credentials.service

# Sunday 04:40 local: after the 03:20 backup has finished, so the week's dump
# still contains the rows this is about to remove. That ordering is the point of
# the hour, not the hour itself.
OnCalendar=Sun *-*-* 04:40:00

RandomizedDelaySec=30min

# Run on next boot if the machine was off. A self-hosted instance that sleeps at
# night would otherwise never sweep at all.
Persistent=true

[Install]
WantedBy=timers.target
