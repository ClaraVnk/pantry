# Chaudron — configuration template.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit secrets.
# Every key below is read at startup and validated (fail-fast on missing/invalid values).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Deployment environment: local | ci | staging | production
# REQUIRED, and deliberately without a default. It used to default to `local`,
# which is the value that opens /docs and /openapi.json and turns HSTS off — so
# a copy of this file with the variable left blank produced a public instance
# publishing its whole API surface, silently. The process now refuses to start
# rather than guess.
CHAUDRON_ENV=
# Log level: DEBUG | INFO | WARNING | ERROR
# DEBUG is refused at startup when CHAUDRON_ENV=production: the level is applied
# to the root logger, and sqlalchemy.engine then writes every statement with its
# bound parameters — allergens, infant age bands, amounts — in clear text.
CHAUDRON_LOG_LEVEL=
# Port the ASGI server binds to inside the container
CHAUDRON_PORT=
# Public base URL of the API, used to build absolute links
CHAUDRON_BASE_URL=

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16, async driver)
# ---------------------------------------------------------------------------
# Full async DSN: postgresql+asyncpg://user:password@host:5432/dbname
#
# IMPORTANT — this must name the application role, not the role that owns the
# tables. PostgreSQL exempts a table's owner from its own row-level security
# policies, so an API connecting as the owner enforces nothing between
# households while every endpoint keeps answering normally. See ops/README.md
# section 6 and `backend/scripts/provision_app_role.py`.
CHAUDRON_DATABASE_URL=
# SQLAlchemy connection pool size
CHAUDRON_DB_POOL_SIZE=
# Extra connections allowed above the pool size
CHAUDRON_DB_MAX_OVERFLOW=

# ---------------------------------------------------------------------------
# Row-level security — provisioning only
# ---------------------------------------------------------------------------
# Read by `backend/scripts/provision_app_role.py`, never by the API. Run that
# script with CHAUDRON_DATABASE_URL pointing at the OWNER, then put the app
# role's own DSN in CHAUDRON_DATABASE_URL above and keep the owner DSN for
# `alembic upgrade` only.
#
# Name of the non-owner role the application connects as (default: chaudron_app)
CHAUDRON_DB_APP_ROLE=
# Its password. Supply it for the length of one command and unset it after:
#   read -rs -p 'App role password: ' CHAUDRON_DB_APP_PASSWORD && export CHAUDRON_DB_APP_PASSWORD
#   uv run python scripts/provision_app_role.py && unset CHAUDRON_DB_APP_PASSWORD
# Leave empty here: this file is a template, not a vault.
CHAUDRON_DB_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Random 32+ character instance secret (generate: openssl rand -hex 32). The
# CalDAV feed credential is derived from it by HKDF, per household and per epoch.
CHAUDRON_SECRET_KEY=
# There are no JWT settings here, and there is no JWT in the application.
# Sessions are rows in `user_session` and machine tokens are SHA-256 digests in
# `machine_token`; both are random values looked up in the database, so there is
# nothing to sign and no algorithm to configure. `CHAUDRON_JWT_TTL_MINUTES` and
# `CHAUDRON_JWT_ALGORITHM` were scaffolding read by nothing, and were removed
# rather than kept: a configurable signing algorithm accepting `none` is an
# algorithm-confusion vector for a mechanism this application does not use.

# ---------------------------------------------------------------------------
# Reverse-proxy trust — read by uvicorn, not by the application
# ---------------------------------------------------------------------------
# Which peer addresses uvicorn honours `X-Forwarded-For` / `X-Forwarded-Proto`
# from. Uvicorn's own default is 127.0.0.1, which under rootless Podman is never
# the address the API sees — the peer is the proxy's container address — so the
# forwarded headers were silently ignored. Right outcome, accidental cause.
#
# LEAVE THIS EMPTY HERE. In a quadlet deployment it is set by
# `ops/chaudron.container` to the proxy's pinned address on chaudron-net
# (10.89.7.10), and `--env` beats `--env-file`, so a value written here is
# ignored anyway. It is documented in this file so the variable is not a
# surprise, not so it can be configured here.
#
# NEVER set it to `*`. That tells uvicorn to trust the forwarded headers of
# whoever connects, which makes every rate limit and every IP-based decision in
# the stack one header away from being whatever the caller wants. It is also the
# most common answer to this problem online.
#
# Confirm the real value rather than assuming it:
#   podman inspect chaudron-proxy \
#     --format '{{.NetworkSettings.Networks.chaudron-net.IPAddress}}'
FORWARDED_ALLOW_IPS=

# ---------------------------------------------------------------------------
# Household credential encryption — REQUIRED
# ---------------------------------------------------------------------------
# Households store their own provider API keys. Those are encrypted at rest with
# this key, which must never live in the database: a stolen dump must not be
# enough to decrypt third-party secrets. Generate: openssl rand -base64 32
# Rotating this value invalidates every stored household credential.
CHAUDRON_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# `instance_owner` mode — the operator's OWN keys, for the operator's OWN household
# ---------------------------------------------------------------------------
# Chaudron never funds inference for its users. The keys below are usable only by
# the household named here; every other household must bring its own (`byok`) or
# point at an Ollama instance. Leave empty to disable the mode entirely.
CHAUDRON_INSTANCE_OWNER_HOUSEHOLD_ID=

# Fill in only the providers you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Model used for documentation, examples and the `instance_owner` mode
CHAUDRON_LLM_DEFAULT_MODEL=claude-opus-5
# Max output tokens per request
CHAUDRON_LLM_MAX_TOKENS=
# Ceiling on spend per calendar month, in USD. Only meaningful for
# `instance_owner` mode — in `byok` the household is billed by its own provider,
# and in `ollama` nothing is billed at all.
CHAUDRON_LLM_MONTHLY_BUDGET_USD=
# Timeout for a single provider call, in seconds
CHAUDRON_LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Ollama — local inference (server-side, colocated only)
# ---------------------------------------------------------------------------
# Households supply their own Ollama base URL, and the server calls it: that is
# an SSRF primitive. Blocking private ranges does not work here, because a
# legitimate colocated Ollama address IS private. An explicit host allowlist is
# therefore the control. Comma-separated `host:port` endpoints, typically the
# Podman service name of the Ollama container: `ollama:11434`. The port is part
# of the control -- without it a household could dial every *other* port of an
# allowed host and tell open ones from closed ones, which is a port scanner. A
# bare `host` is accepted and means port 11434 only, never "any port".
# IPv6 literals are written bracketed: `[::1]:11434`. Empty disables `ollama`.
CHAUDRON_OLLAMA_ALLOWED_HOSTS=
# Timeout for a single Ollama call, in seconds — local models can be slow
CHAUDRON_OLLAMA_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Open Food Facts — product lookup by barcode
# ---------------------------------------------------------------------------
# Required by their API policy: "AppName/version (contact-email)"
CHAUDRON_OFF_USER_AGENT=
# Base URL of the Open Food Facts API
CHAUDRON_OFF_BASE_URL=https://world.openfoodfacts.org
# Cache lifetime for product lookups, in seconds
CHAUDRON_OFF_CACHE_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Inbound email — receipts forwarded for OCR
# ---------------------------------------------------------------------------
# Shared secret validating the inbound-email webhook signature
CHAUDRON_INBOUND_EMAIL_WEBHOOK_KEY=
# Domain that receives forwarded receipts, e.g. receipts.example.org
CHAUDRON_INBOUND_EMAIL_DOMAIN=
# Max accepted attachment size, in bytes
CHAUDRON_INBOUND_EMAIL_MAX_BYTES=

# ---------------------------------------------------------------------------
# Abuse and availability limits
# ---------------------------------------------------------------------------
# These are counted PER PROCESS, in memory. Two uvicorn workers grant two
# budgets, and a restart forgets every counter. That is accepted for this slice
# and documented in backend/src/chaudron/api/throttling.py; moving past one
# worker requires moving the counters to PostgreSQL first.

# Max accepted request body, in bytes. Default 262144 (256 KiB) — a hundredfold
# margin over the largest legitimate v1 request. Deliberately NOT sized for the
# receipt photo import: that route needs the order of magnitude of
# CHAUDRON_INBOUND_EMAIL_MAX_BYTES below (10 MiB) and must carry its own,
# higher, per-route bound rather than raising this one for every endpoint.
CHAUDRON_MAX_REQUEST_BODY_BYTES=
# Recipe suggestions per household per hour. Each one is a billed model call.
CHAUDRON_RECIPE_SUGGESTIONS_PER_HOUR=
# Recipe suggestions in flight at once, per household — two open tabs must not
# double the bill.
CHAUDRON_RECIPE_MAX_CONCURRENT_PER_HOUSEHOLD=
# Recipe suggestions in flight at once, for the whole process. Lower it to 1 or 2
# when inference runs on a colocated Ollama on a small machine (ADR-0007).
CHAUDRON_RECIPE_MAX_CONCURRENT_TOTAL=
# Barcode lookups per household per minute. Must stay BELOW the ten calls a
# minute that Open Food Facts allows this whole instance, or one household can
# still drain the shared budget on its own (ADR-0008).
CHAUDRON_PRODUCT_LOOKUPS_PER_MINUTE=

# ---------------------------------------------------------------------------
# Machine access tokens (api contract v1.1 section 10)
# ---------------------------------------------------------------------------
# Live tokens one household may hold at once. Generous on purpose: the bound is
# there so a loop in a misconfigured client cannot fill a table, not to ration a
# household that runs several integrations. Default 20.
CHAUDRON_MACHINE_TOKENS_PER_HOUSEHOLD=
# REJECTED token presentations per source address per hour. Only failures are
# counted: a running integration presents the same valid token on a timer, and
# charging those would throttle the legitimate use while leaving a guesser
# exactly the same budget. Default 60. Behind a reverse proxy every caller
# collapses into one bucket, so raise it there rather than lowering it.
CHAUDRON_MACHINE_TOKEN_ATTEMPTS_PER_IP_PER_HOUR=

# ---------------------------------------------------------------------------
# Shopping-list import (api contract 7.3)
# ---------------------------------------------------------------------------
# These four bounds are separate from CHAUDRON_MAX_REQUEST_BODY_BYTES above: that
# one sizes a JSON body, and an uploaded document is not a JSON body. The first
# three answer 413 when passed; the fourth drops the extra lines and says so.

# Largest accepted PDF or .txt upload, in bytes. Default 1048576 (1 MiB), and the
# number is not arbitrary: Starlette spools an uploaded part to a temporary file
# on disk past exactly this size, so at or below it the document never touches
# the filesystem — which is what "the file is not kept" should mean. Raising it
# is allowed and starts spooling to disk; the upload is closed, and therefore
# unlinked, on every path out of the handler either way.
CHAUDRON_SHOPPING_IMPORT_MAX_BYTES=
# Pages read from an uploaded PDF. Default 20. A household shopping list is one
# or two pages; the bound is what keeps one request from buying unbounded work.
CHAUDRON_SHOPPING_IMPORT_MAX_PDF_PAGES=
# Characters of text extracted from a document, across all pages. Default 200000
# (~2000 shopping-list lines). This is the only bound standing between a highly
# compressible PDF content stream and this process's memory.
CHAUDRON_SHOPPING_IMPORT_MAX_TEXT_CHARS=
# Candidate lines kept in one proposal. Default 500. Unlike the three above, an
# overrun does NOT answer 413: the extra lines are dropped and the response
# carries "truncated": true, because a list one line too long is still worth
# importing whereas a document too big to read is not.
CHAUDRON_SHOPPING_IMPORT_MAX_LINES=

# ---------------------------------------------------------------------------
# Calendar feed — expiry alerts published over CalDAV (docs/calendar-feed.md)
# ---------------------------------------------------------------------------
# Publishing the feed means publishing a household's inventory to whatever device
# holds its credentials — asset A3 of docs/security-model.md, potentially
# sensitive under article 9 GDPR. It is therefore OFF unless an operator says
# otherwise, and turning it off again is the immediate, instance-wide kill
# switch. HTTPS is required in practice: CalDAV authenticates with Basic, so the
# secret travels in the clear on a plain connection.
# true | false
CHAUDRON_CALENDAR_FEED_ENABLED=

# Mixed into the key every feed credential is derived from. Bump it to invalidate
# every credential this instance ever issued — the rotation to reach for after a
# leak — without touching CHAUDRON_SECRET_KEY and therefore without logging
# anybody out. Per-household revocation needs a column and does not exist yet;
# docs/calendar-feed.md section 10 carries the design. Defaults to 1.
CHAUDRON_CALENDAR_FEED_EPOCH=

# ---------------------------------------------------------------------------
# Shopping-list export (ADR-0010)
# ---------------------------------------------------------------------------
# The primary export path needs no configuration at all: the browser shares the
# plain-text list through navigator.share, and nothing leaves this instance.
# What follows enables the optional Todoist destination.
#
# Per-household destinations need a table that does not exist yet (ADR-0010,
# section 7). Until it does, the token below belongs to the OPERATOR and is
# usable by exactly ONE household -- the same locked door as `instance_owner` in
# ADR-0007, for the same reason: a token every household could use would file
# strangers' groceries into the operator's own list. Leave empty to disable.
CHAUDRON_TODOIST_HOUSEHOLD_ID=
# A Todoist *personal* API token, not an OAuth credential: Settings ->
# Integrations -> Developer. Revoke it from the same page. Prefer a podman
# secret over a value written here.
# Set it without putting it in your shell history:
#   read -rs CHAUDRON_TODOIST_TOKEN && printf %s "$CHAUDRON_TODOIST_TOKEN" | podman secret create chaudron-todoist-token - && unset CHAUDRON_TODOIST_TOKEN
CHAUDRON_TODOIST_TOKEN=
# Todoist project the items are added to. Empty means the account's Inbox.
CHAUDRON_TODOIST_PROJECT_ID=

# Bounds on the outbound call. The destination hostnames are compiled in, so
# there is no allowlist here -- but a fixed hostname is not a promise of good
# behaviour, and both bounds are enforced on every call. Defaults: 15 seconds,
# 512 KiB.
CHAUDRON_TODO_EXPORT_TIMEOUT_SECONDS=
CHAUDRON_TODO_EXPORT_MAX_RESPONSE_BYTES=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins, e.g. https://chaudron.example.org
# '*' is refused at startup: the session is a cookie, so a wildcard is both
# rejected by browsers when credentials are allowed and, without them, a way for
# any site on the internet to read a household's data.
# Leave empty when the PWA is served from the same origin as the API.
CHAUDRON_CORS_ORIGINS=
# Allow cookies on cross-origin requests: true | false.
# REQUIRED to be true whenever CHAUDRON_CORS_ORIGINS lists an origin — the
# session travels in a cookie, and a cross-origin browser client cannot send one
# otherwise. Startup refuses the inconsistent pair rather than serving a frontend
# where every call answers 401 for no visible reason.
CHAUDRON_CORS_ALLOW_CREDENTIALS=

# ---------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------
# Serve /docs and /openapi.json: true | false. Empty means "only when
# CHAUDRON_ENV is local" — a forgotten variable must close the documentation,
# not open it.
CHAUDRON_ENABLE_DOCS=
